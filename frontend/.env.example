# Frontend Environment Variables
# In production on Vercel (unified deployment via root vercel.json), leave blank or use /api/v1.
# If deploying frontend and backend as separate Vercel projects, set VITE_API_URL to your backend URL:
# VITE_API_URL=https://your-backend-project.vercel.app/api/v1

VITE_API_URL=http://127.0.0.1:8000/api/v1

